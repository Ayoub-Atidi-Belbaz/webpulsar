<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code | default: 'es' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0B0B12">
    <meta name="color-scheme" content="dark">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%}
      OpenAI Ads (ChatGPT) — píxel de medición diferido para no competir con el LCP ni bloquear el render inicial.
    {%- endcomment -%}
    <script>
      (function() {
        function loadPixel() {
          if (window.__oaiqLoaded) return;
          window.__oaiqLoaded = true;
          !function(w,d,s,u){if(w.oaiq)return;var q=function(){q.q.push(arguments)};q.q=[];w.oaiq=q;var j=d.createElement(s);j.async=1;j.src=u;var f=d.getElementsByTagName(s)[0];f.parentNode.insertBefore(j,f)}(window,document,"script","https://bzrcdn.openai.com/sdk/oaiq.min.js");
          if (window.oaiq) oaiq("init",{pixelId:"LoztKSiH9pGy92FzDsL633",debug:false});
        }
        if (document.readyState === 'complete') {
          setTimeout(loadPixel, 1200);
        } else {
          window.addEventListener('load', function() {
            (window.requestIdleCallback || function(cb){ setTimeout(cb, 1200); })(loadPixel);
          }, { once: true });
        }
      })();
    </script>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- assign fallback_description = 'Webs profesionales para negocios locales, desde 49 €. Sin permanencia ni cuotas ocultas.' -%}
    <meta name="description" content="{{ page_description | default: fallback_description | escape }}">

    {% render 'meta-tags' %}
    {% render 'structured-data' %}

    {%- comment -%} CSS Crítico Above-the-fold incrustado en línea {%- endcomment -%}
    {% render 'critical' %}

    {%- comment -%} Precarga de tipografía local Clash Display {%- endcomment -%}
    <link rel="preload" href="{{ 'clash-display-variable.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

    {%- comment -%} Carga diferida y asíncrona de hojas de estilo no críticas {%- endcomment -%}
    <link rel="stylesheet" href="{{ 'tokens.css' | asset_url }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'motion-system.css' | asset_url }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'components.css' | asset_url }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'layout.css' | asset_url }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'sections.css' | asset_url }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'qm-webs.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript>
      {{ 'tokens.css' | asset_url | stylesheet_tag }}
      {{ 'motion-system.css' | asset_url | stylesheet_tag }}
      {{ 'base.css' | asset_url | stylesheet_tag }}
      {{ 'components.css' | asset_url | stylesheet_tag }}
      {{ 'layout.css' | asset_url | stylesheet_tag }}
      {{ 'sections.css' | asset_url | stylesheet_tag }}
      {{ 'qm-webs.css' | asset_url | stylesheet_tag }}
    </noscript>

    {%- comment -%}
      Speculation Rules API: Precarga de navegación interna para transiciones instantáneas
    {%- endcomment -%}
    <script type="speculationrules">
      {
        "prefetch": [
          {
            "source": "document",
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": "/cart*" } },
                { "not": { "href_matches": "/checkout*" } },
                { "not": { "href_matches": "/account*" } },
                { "not": { "href_matches": "/*\\?*" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>

    {%- comment -%}
      Acento de marca configurable desde el editor sin tocar el CSS.
    {%- endcomment -%}
    {%- if settings.brand_accent != blank -%}
      {% style %}
        :root { --c-violet: {{ settings.brand_accent }}; }
      {% endstyle %}
    {%- endif -%}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      if (window.Shopify && Shopify.designMode) document.documentElement.classList.add('shopify-design-mode');
    </script>

    {%- comment -%} Standard Events de Shopify: analítica nativa de la tienda {%- endcomment -%}
    <script type="module">
      import * as StandardEvents from 'https://cdn.shopify.com/storefront/standard-events.js';
      window.StandardEvents = StandardEvents;
      document.addEventListener('DOMContentLoaded', () => {
        const template = document.querySelector('main[data-template]')?.dataset.template || '';
        document.dispatchEvent(
          new StandardEvents.PageViewEvent({
            page: { template, title: document.title, url: window.location.href }
          })
        );
      }, { once: true });
    </script>

    <script src="{{ 'lenis.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'motion.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'video-player.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'qm-webs.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'market.js' | asset_url }}" defer="defer"></script>
    {%- if template.name == 'cart' -%}
      <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-suffix-{{ template.suffix | handle }}{% endif %}">
    <a class="skip-to-content visually-hidden" href="#main">{{ 'accessibility.skip_to_text' | t }}</a>

    <div class="grain" aria-hidden="true"></div>

    {% sections 'header-group' %}

    <main id="main" tabindex="-1" data-template="{{ template.name }}">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- render 'video-lightbox' -%}
    {%- render 'cookie-banner' -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}'
      };
      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`
      };
    </script>
  </body>
</html>
