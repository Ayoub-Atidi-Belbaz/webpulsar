{%- liquid
  assign menu = section.settings.menu
  assign cart_count = cart.item_count
-%}

<header
  class="site-header{% if section.settings.static_header %} is-static{% endif %}"
  data-header
  {% if section.settings.static_header %}data-header-static{% endif %}
>
  <div class="wrap site-header__inner">
    {%- comment -%} Marca {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="brand" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 320
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '120, 180, 240, 320',
            sizes: '160px',
            alt: shop.name,
            style: '--brand-h: 26px;'
        }}
      {%- else -%}
        <span class="brand__mark" aria-hidden="true">{{ shop.name | slice: 0 }}</span>
        <span>{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- comment -%} Reloj y ubicación local editorial (Bloque A) {%- endcomment -%}
    {%- if section.settings.show_clock -%}
      <div
        class="header-clock hide-mobile"
        data-header-clock
        data-tz="{{ section.settings.clock_timezone | default: 'Europe/Madrid' }}"
        title="Hora local en {{ section.settings.clock_location | default: 'Murcia, ES' }}"
        aria-label="Ubicación y hora local: {{ section.settings.clock_location | default: 'Murcia, ES' }}"
      >
        <span class="header-clock__dot" aria-hidden="true"></span>
        <span class="header-clock__loc">{{ section.settings.clock_location | default: 'Murcia, ES' }}</span>
        <span class="header-clock__sep" aria-hidden="true">·</span>
        <span class="header-clock__time" data-clock-time>--:--</span>
      </div>
    {%- endif -%}

    {%- comment -%} Navegación de escritorio {%- endcomment -%}
    {%- if menu != blank -%}
      <nav class="nav" aria-label="{{ 'sections.header.menu' | t }}">
        {%- for link in linklists[menu].links -%}
          <a
            href="{{ link.url }}"
            class="nav__link"
            {% if link.current or link.child_active %}aria-current="page"{% endif %}
          >{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="site-header__actions">
      {%- if section.settings.show_market_selector -%}
        <div class="hide-mobile">{% render 'market-selector', id: 'header' %}</div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: routes.root_url }}" class="btn btn--primary btn--sm header-cta">
          <span>{{ section.settings.cta_label }}</span>
        </a>
      {%- endif -%}

      {%- if section.settings.show_cart -%}
        <a
          href="{{ routes.cart_url }}"
          class="cart-link"
          aria-label="{{ 'templates.cart.cart' | t | default: 'Carrito' }}{% if cart_count > 0 %}, {{ cart_count }} {% if cart_count == 1 %}artículo{% else %}artículos{% endif %}{% endif %}"
        >
          {% render 'icon', name: 'cart', size: 19 %}
          <span class="cart-link__count{% if cart_count == 0 %} is-hidden{% endif %}" data-cart-count aria-hidden="true">{{ cart_count }}</span>
        </a>
      {%- endif -%}

      <button
        type="button"
        class="burger"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="{{ 'sections.header.menu' | t }}"
        data-burger
      >
        <span></span>
      </button>
    </div>
  </div>
</header>

{%- comment -%} Menú móvil editorial a pantalla completa (Bloque B) {%- endcomment -%}
<div
  class="mobile-nav"
  id="mobile-nav"
  data-mobile-nav
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'sections.header.menu' | t }}"
  hidden
>
  <div class="mobile-nav__inner">
    {%- if menu != blank -%}
      <nav class="mobile-nav__menu" aria-label="{{ 'sections.header.menu' | t }}">
        {%- for link in linklists[menu].links -%}
          <a
            href="{{ link.url }}"
            class="mobile-nav__link"
            style="--i: {{ forloop.index }};"
            {% if link.current or link.child_active %}aria-current="page"{% endif %}
          >
            <span class="mobile-nav__num">0{{ forloop.index }}</span>
            <span class="mobile-nav__title">{{ link.title }}</span>
            <span class="mobile-nav__arrow" aria-hidden="true">
              {% render 'icon', name: 'arrow-up-right', size: 18 %}
            </span>
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="mobile-nav__footer">
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: routes.root_url }}" class="btn btn--primary btn--full btn--lg">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}

      <div class="mobile-nav__meta-row">
        {%- if section.settings.show_clock -%}
          <div
            class="header-clock header-clock--mobile"
            data-header-clock
            data-tz="{{ section.settings.clock_timezone | default: 'Europe/Madrid' }}"
          >
            <span class="header-clock__dot" aria-hidden="true"></span>
            <span class="header-clock__loc">{{ section.settings.clock_location | default: 'Murcia, ES' }}</span>
            <span class="header-clock__sep">·</span>
            <span class="header-clock__time" data-clock-time>--:--</span>
          </div>
        {%- endif -%}

        {%- if section.settings.show_market_selector -%}
          {% render 'market-selector', id: 'mobile' %}
        {%- endif -%}
      </div>

      <div class="mobile-nav__contact">
        <a href="mailto:{{ settings.contact_email | default: 'hello@quickmotionai.com' }}" class="mobile-nav__email">
          {{ settings.contact_email | default: 'hello@quickmotionai.com' }}
        </a>
        <span class="mobile-nav__badge">● Respuesta en menos de 24h</span>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var burger = document.querySelector('[data-burger]');
    var nav = document.querySelector('[data-mobile-nav]');
    if (!burger || !nav) return;

    var focusableElementsSelector = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

    function setOpen(open) {
      burger.setAttribute('aria-expanded', String(open));
      if (open) {
        nav.hidden = false;
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(function () {
          nav.classList.add('is-open');
          var firstFocusable = nav.querySelector(focusableElementsSelector);
          if (firstFocusable) firstFocusable.focus();
        });
      } else {
        nav.classList.remove('is-open');
        document.body.style.overflow = '';
        setTimeout(function () {
          if (!nav.classList.contains('is-open')) {
            nav.hidden = true;
            burger.focus();
          }
        }, 320);
      }
    }

    burger.addEventListener('click', function () {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('click', function (e) {
      if (e.target.closest('a')) setOpen(false);
    });

    // Accesibilidad: focus trap dentro del menú móvil
    nav.addEventListener('keydown', function (e) {
      if (e.key === 'Tab') {
        var focusables = Array.prototype.slice.call(nav.querySelectorAll(focusableElementsSelector)).filter(function (el) {
          return el.offsetParent !== null;
        });
        if (!focusables.length) return;
        var first = focusables[0];
        var last = focusables[focusables.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === first || document.activeElement === nav) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
      }
    });

    window.addEventListener('resize', function () {
      if (window.innerWidth >= 990 && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Cabecera",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logotipo", "info": "SVG o PNG con fondo transparente. Si lo dejas vacío se usa el nombre de la tienda." },
    { "type": "link_list", "id": "menu", "label": "Menú", "default": "main-menu" },
    { "type": "header", "content": "Acciones" },
    { "type": "text", "id": "cta_label", "label": "Texto del botón", "default": "Ver precios" },
    { "type": "url", "id": "cta_url", "label": "Enlace del botón" },
    { "type": "checkbox", "id": "show_market_selector", "label": "Mostrar selector de mercado", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "Mostrar icono de carrito", "default": true },
    { "type": "header", "content": "Reloj de cabecera" },
    { "type": "checkbox", "id": "show_clock", "label": "Mostrar reloj y ubicación", "default": true },
    { "type": "text", "id": "clock_location", "label": "Texto de ubicación", "default": "Murcia, ES" },
    { "type": "text", "id": "clock_timezone", "label": "Zona horaria IANA", "default": "Europe/Madrid" },
    { "type": "header", "content": "Comportamiento" },
    { "type": "checkbox", "id": "static_header", "label": "Cabecera siempre visible", "default": false, "info": "Por defecto la cabecera se oculta al bajar y reaparece al subir." }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}

{% include 'alireviews_aggregateRating' %}