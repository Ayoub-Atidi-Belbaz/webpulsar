{{ 'qm-webs.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

{%- if section.blocks.size > 0 -%}
  <section class="section qw-testimonials" id="testimonios" data-reveal="fade">
    <div class="wrap">
      <div class="section-head section-head--center">
        {%- if s.eyebrow != blank -%}
          <p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>
        {%- endif -%}
        <h2 class="t-h2" data-reveal>
          {{ s.heading }}
          {%- if s.heading_accent != blank -%}
            <span class="t-grad">{{ s.heading_accent }}</span>
          {%- endif -%}
        </h2>
        {%- if s.body != blank -%}
          <p class="t-lead" data-reveal style="--reveal-delay: 80ms">{{ s.body }}</p>
        {%- endif -%}
      </div>

      <div class="qw-testimonials__grid" data-stagger="90">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <article class="qw-testimonial card--glow" data-reveal {{ block.shopify_attributes }}>
            <div class="qw-testimonial__rating" aria-label="Calificación: {{ b.rating }} de 5">
              {%- for i in (1..b.rating) -%}
                <svg class="qw-testimonial__star" viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              {%- endfor -%}
            </div>

            <blockquote class="qw-testimonial__quote">
              “{{ b.quote }}”
            </blockquote>

            <div class="qw-testimonial__author-box">
              <div class="qw-testimonial__meta">
                <span class="qw-testimonial__name">{{ b.author }}</span>
                {%- if b.role != blank -%}
                  <span class="qw-testimonial__role">{{ b.role }}</span>
                {%- endif -%}
              </div>

              {%- if b.verified -%}
                <span class="qw-testimonial__verified" title="Opinión y cliente verificado">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  Verificado
                </span>
              {%- endif -%}
            </div>

            {%- if b.project_url != blank -%}
              <div class="qw-testimonial__link-wrap">
                <a href="{{ b.project_url }}" target="_blank" rel="noopener" class="qw-testimonial__link">
                  <span>{{ b.project_label | default: 'Ver proyecto' }}</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7m0 0H8.5M17 7v8.5"/></svg>
                </a>
              </div>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Webs · Testimonios",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "OPINIONES" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Lo que dicen de" },
    { "type": "text", "id": "heading_accent", "label": "Titular con acento", "default": "trabajar con nosotros" },
    { "type": "textarea", "id": "body", "label": "Subtítulo", "default": "Opiniones reales y verificadas de proyectos entregados." }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonio",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Cita / Testimonio", "default": "La entrega fue en 5 días y el soporte por WhatsApp inmediato. Muy contentos con el resultado." },
        { "type": "text", "id": "author", "label": "Nombre del cliente", "default": "Carlos M." },
        { "type": "text", "id": "role", "label": "Cargo / Negocio", "default": "Gerente · Sector Servicios" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Calificación (estrellas)", "default": 5 },
        { "type": "checkbox", "id": "verified", "label": "Mostrar insignia de verificado", "default": true },
        { "type": "url", "id": "project_url", "label": "Enlace al proyecto (opcional)" },
        { "type": "text", "id": "project_label", "label": "Texto del enlace", "default": "Ver proyecto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Webs · Testimonios"
    }
  ]
}
{% endschema %}
