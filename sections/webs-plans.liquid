{{ 'qm-webs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'qm-webs.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
-%}

<section class="section qw-plans" id="planes" data-qw-pricing>
  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if s.eyebrow != blank -%}
        <p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>
      {%- endif -%}
      <h2 class="t-h2" data-reveal>
        {{ s.heading }}
        {%- if s.heading_accent != blank -%}<span class="t-grad">{{ s.heading_accent }}</span>{%- endif -%}
      </h2>
      {%- if s.body != blank -%}
        <p class="t-lead" data-reveal style="--reveal-delay: 80ms">{{ s.body }}</p>
      {%- endif -%}
    </div>

    <div class="qw-plans__carousel" data-plans-carousel>
      <div class="qw-plans__grid" data-stagger="90" data-plans-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign features = b.features | newline_to_br | split: '<br />'
          assign event_name = b.event | default: 'click_plan'
          assign plan_code = b.plan_value | default: b.name | handle | upcase
          assign order_code = 'QW-' | append: plan_code
          assign plan_slug = b.plan_value | default: b.name | downcase | strip
        -%}
        <div class="qw-receipt-wrap" data-reveal {{ block.shopify_attributes }}>
          <article class="qw-receipt{% if b.featured %} qw-receipt--featured{% endif %}">
            {%- if b.featured and b.flag != blank -%}
              <span class="qw-receipt__flag">{{ b.flag }}</span>
            {%- endif -%}

            <header class="qw-receipt__head">
              <p class="qw-receipt__merchant">WebPulsar</p>
              <p class="qw-receipt__note">Webs para negocios reales</p>
            </header>

            <div class="qw-receipt__rule"></div>

            <dl class="qw-receipt__ledger">
              <div><dt>Pedido</dt><dd>{{ order_code }}</dd></div>
              <div><dt>Facturación</dt><dd>{{ b.pay_label | default: 'Pago único' }}</dd></div>
            </dl>

            <div class="qw-receipt__rule"></div>

            <div class="qw-receipt__plan">
              <h3>{{ b.name }}</h3>
              {%- if b.tagline != blank -%}<p>{{ b.tagline }}</p>{%- endif -%}
            </div>

            <div class="qw-receipt__rule"></div>

            <div class="qw-receipt__total">
              <div class="qw-receipt__total-row">
                <span>Total</span>
                <span class="qw-price qw-price--md">
                  <span>{{ b.price }}</span>
                  <span class="qw-price__cur">{{ b.currency | default: '€' }}</span>
                  {%- if b.period != blank -%}<span class="qw-price__per">{{ b.period }}</span>{%- endif -%}
                </span>
              </div>
            </div>

            <a
              href="{% if b.variant_id != blank %}/cart/{{ b.variant_id }}:1{% else %}{{ b.cta_url | default: '#quiero-mi-web' }}{% endif %}"
              class="btn {% if b.featured %}btn--primary{% else %}btn--ghost{% endif %} btn--full qw-receipt__cta"
              data-qw-cta="{{ event_name }}"
              data-plan="{{ plan_slug }}"
              {%- if b.variant_id != blank %}
                data-qw-buy="{{ b.variant_id }}"
                {%- if plan_slug == 'starter' %}
                  data-qw-buy-dest="cart"
                {%- endif %}
              {%- endif %}
            >
              {{ b.cta_label }}
            </a>

            {%- if b.promo_enabled -%}
              <div class="qw-receipt__promo{% if b.promo_emphasis %} qw-receipt__promo--emphasis{% endif %}" data-reveal>
                {%- if b.promo_tag != blank -%}
                  <span class="chip chip--violet qw-receipt__promo-tag">{{ b.promo_tag }}</span>
                {%- endif -%}
                <div class="qw-receipt__promo-row">
                  <span class="qw-receipt__promo-icon">{% render 'icon', name: 'gift', size: 15 %}</span>
                  <div class="qw-receipt__promo-copy">
                    {%- if b.promo_title != blank -%}<p class="qw-receipt__promo-title">{{ b.promo_title }}</p>{%- endif -%}
                    {%- if b.promo_highlight != blank -%}<p class="qw-receipt__promo-highlight">{{ b.promo_highlight }}</p>{%- endif -%}
                  </div>
                </div>
                {%- if b.promo_note != blank -%}
                  <p class="qw-receipt__promo-note">{{ b.promo_note }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="qw-receipt__rule"></div>

            <ul class="qw-receipt__items">
              {%- for feature in features -%}
                {%- assign line = feature | strip_newlines | strip -%}
                {%- if line != blank -%}
                  <li>
                    <span>{{ line }}</span>
                    <span class="qw-receipt__leader" aria-hidden="true"></span>
                    {% render 'icon', name: 'check', size: 11 %}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

            <div class="qw-receipt__barcode" aria-hidden="true"></div>
            <p class="qw-receipt__code">{{ order_code }}</p>
          </article>
        </div>
      {%- endfor -%}
      </div>

      <p class="qw-plans__hint" aria-hidden="true">
        {% render 'icon', name: 'arrow-right', size: 14 %}
        Desliza para ver todos los planes
        {% render 'icon', name: 'arrow-right', size: 14 %}
      </p>

      <div class="qw-plans__dots" data-plans-dots role="tablist" aria-label="Planes"></div>
    </div>

    {%- if s.foot_note != blank -%}
      <p class="qw-note" style="margin-top: var(--s-8); max-width: 680px; margin-inline: auto;" data-reveal="fade">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.6v.2"/></svg>
        <span>{{ s.foot_note }}</span>
      </p>
    {%- endif -%}

    {%- if s.promo_legal_note != blank -%}
      <p class="qw-note qw-note--muted" style="margin-top: var(--s-4); max-width: 680px; margin-inline: auto;" data-reveal="fade">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8 12h8M8 15.5h5"/></svg>
        <span>{{ s.promo_legal_note }}</span>
      </p>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    function boot(root) {
      var carousel = (root || document).querySelector('[data-plans-carousel]');
      if (!carousel || carousel.__plansInit) return;
      carousel.__plansInit = true;

      var track = carousel.querySelector('[data-plans-track]');
      var dotsWrap = carousel.querySelector('[data-plans-dots]');
      var cards = Array.prototype.slice.call(track.children);
      if (cards.length < 2) return;

      cards.forEach(function (card, i) {
        var dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'qw-plans__dot';
        dot.setAttribute('aria-label', 'Ir al plan ' + (i + 1));
        dot.addEventListener('click', function () {
          cards[i].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        });
        dotsWrap.appendChild(dot);
      });
      var dots = Array.prototype.slice.call(dotsWrap.children);

      function updateActive() {
        var trackRect = track.getBoundingClientRect();
        var center = trackRect.left + trackRect.width / 2;
        var closest = 0;
        var closestDist = Infinity;
        cards.forEach(function (card, i) {
          var r = card.getBoundingClientRect();
          var dist = Math.abs((r.left + r.width / 2) - center);
          if (dist < closestDist) { closestDist = dist; closest = i; }
        });
        dots.forEach(function (dot, i) { dot.classList.toggle('is-active', i === closest); });
      }

      var ticking = false;
      track.addEventListener('scroll', function () {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () { updateActive(); ticking = false; });
      }, { passive: true });

      window.addEventListener('resize', updateActive);
      updateActive();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { boot(document); });
    } else {
      boot(document);
    }
    document.addEventListener('shopify:section:load', function (e) { boot(e.target); });
  })();
</script>

{% schema %}
{
  "name": "Webs · Planes",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Planes" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Elige hasta dónde quieres llegar." },
    { "type": "text", "id": "heading_accent", "label": "Parte destacada" },
    { "type": "textarea", "id": "body", "label": "Subtítulo", "default": "Empieza por lo básico y sube de plan cuando tu negocio lo pida. Sin permanencia en ningúno." },
    { "type": "textarea", "id": "foot_note", "label": "Nota bajo los planes", "default": "Hosting no incluido en ningún plan. El dominio está incluido temporalmente en los planes PRO y BUSINESS durante la promoción de lanzamiento; en el resto de planes se paga aparte. Te pasamos el coste exacto antes de empezar." },
    { "type": "textarea", "id": "promo_legal_note", "label": "Nota legal de la promoción", "info": "Se muestra debajo de la nota anterior, solo si tiene texto.", "default": "Dominio incluido durante el periodo promocional. La renovación posterior se realizará según las condiciones vigentes." }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre", "default": "STARTER" },
        { "type": "text", "id": "price", "label": "Importe", "default": "49" },
        { "type": "text", "id": "currency", "label": "Moneda", "default": "€" },
        { "type": "text", "id": "period", "label": "Periodo", "info": "Por ejemplo /mes. Déjalo vacío en pagos únicos." },
        { "type": "text", "id": "pay_label", "label": "Tipo de pago", "default": "Pago único" },
        { "type": "textarea", "id": "tagline", "label": "Para quién es", "default": "Para negocios que simplemente necesitan estar online." },
        { "type": "textarea", "id": "features", "label": "Incluye", "info": "Una línea por característica.", "default": "1 página\nDiseño responsive\nWhatsApp\nServicios\nGalería\nContacto" },
        { "type": "header", "content": "Botón" },
        { "type": "text", "id": "cta_label", "label": "Texto del botón", "default": "Empezar" },
        { "type": "url", "id": "cta_url", "label": "Enlace (alternativo)", "info": "Se usa sólo si el ID de variante de abajo está vacío. Vacío = formulario de la página." },
        { "type": "text", "id": "variant_id", "label": "ID de variante de Shopify", "info": "Si lo rellenas, el botón compra directamente: añade esta variante al carrito. El plan STARTER lleva al carrito (para ofrecer mantenimiento); el resto salta directo al checkout." },
        {
          "type": "select",
          "id": "event",
          "label": "Evento de analítica",
          "options": [
            { "value": "click_starter", "label": "click_starter" },
            { "value": "click_pro", "label": "click_pro" },
            { "value": "click_business", "label": "click_business" },
            { "value": "click_plan", "label": "click_plan" }
          ],
          "default": "click_starter"
        },
        { "type": "text", "id": "plan_value", "label": "Valor en el formulario", "info": "Debe coincidir con una opción del desplegable del formulario para que se preseleccione sola.", "default": "starter" },
        { "type": "header", "content": "Destacado" },
        { "type": "checkbox", "id": "featured", "label": "Marcar como destacado", "default": false },
        { "type": "text", "id": "flag", "label": "Etiqueta del destacado", "default": "MÁS ELEGIDO" },
        { "type": "header", "content": "Promoción de dominio gratis (opcional)" },
        { "type": "checkbox", "id": "promo_enabled", "label": "Mostrar promoción en esta tarjeta", "default": false },
        { "type": "text", "id": "promo_tag", "label": "Etiqueta pequeña", "default": "Promoción de lanzamiento" },
        { "type": "text", "id": "promo_title", "label": "Beneficio destacado", "default": "Dominio gratis" },
        { "type": "text", "id": "promo_highlight", "label": "Texto de impacto", "info": "Por ejemplo: 1 año incluido.", "default": "1 año incluido" },
        { "type": "textarea", "id": "promo_note", "label": "Texto secundario", "default": "Dominio incluido durante el primer año." },
        { "type": "checkbox", "id": "promo_emphasis", "label": "Dar más énfasis visual", "info": "Úsalo en el plan con el beneficio mayor (por ejemplo, BUSINESS frente a PRO).", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Webs · Planes",
      "blocks": [
        {
          "type": "plan",
          "settings": {
            "name": "STARTER", "price": "49", "pay_label": "Pago único",
            "tagline": "Para negocios que simplemente necesitan estar online.",
            "features": "1 página\nDiseño responsive\nWhatsApp\nServicios\nGalería\nContacto",
            "cta_label": "Empezar", "event": "click_starter", "plan_value": "starter", "featured": false
          }
        },
        {
          "type": "plan",
          "settings": {
            "name": "PRO", "price": "199", "pay_label": "Pago único",
            "tagline": "Para negocios que quieren una presencia online más completa.",
            "features": "Hasta 5 páginas\nDiseño personalizado\nSEO básico\nWhatsApp\nFormularios\nGoogle Maps\nRedes sociales\nGalería profesional\nOptimización móvil",
            "cta_label": "Quiero la PRO", "event": "click_pro", "plan_value": "pro", "featured": true, "flag": "MÁS ELEGIDO",
            "promo_enabled": true, "promo_tag": "Promoción de lanzamiento", "promo_title": "Dominio gratis",
            "promo_highlight": "1 año incluido", "promo_note": "Dominio incluido durante el primer año.", "promo_emphasis": false
          }
        },
        {
          "type": "plan",
          "settings": {
            "name": "BUSINESS", "price": "499", "pay_label": "Pago único",
            "tagline": "Para negocios que quieren convertir su web en una herramienta de ventas.",
            "features": "Web completa\nReservas y citas\nAutomatizaciones\nSEO avanzado\nFormularios avanzados\nIntegraciones\nGoogle Business\nAnalítica\nFuncionalidades personalizadas",
            "cta_label": "Quiero BUSINESS", "event": "click_business", "plan_value": "business", "featured": false,
            "promo_enabled": true, "promo_tag": "Promoción de lanzamiento", "promo_title": "Dominio gratis",
            "promo_highlight": "2 años incluidos", "promo_note": "Dominio incluido durante los primeros 2 años.", "promo_emphasis": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
