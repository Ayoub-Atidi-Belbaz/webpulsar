{{ 'qm-webs.css' | asset_url | stylesheet_tag }}
{{ 'qm-webs-calc.css' | asset_url | stylesheet_tag }}
<script src="{{ 'qm-webs.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
-%}

<section class="section qw-calc" id="calculadora" data-qw-calc>
  <span class="halo halo--tr" style="--halo-color: var(--c-violet); --halo-opacity: 0.24;" aria-hidden="true"></span>

  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if s.eyebrow != blank -%}
        <p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>
      {%- endif -%}
      <h2 class="t-h2" data-reveal>
        {{ s.heading }}
        {%- if s.heading_accent != blank -%}<span class="t-grad">{{ s.heading_accent }}</span>{%- endif -%}
      </h2>
      {%- if s.body != blank -%}
        <p class="t-lead" data-reveal style="--reveal-delay: 80ms">{{ s.body }}</p>
      {%- endif -%}
    </div>

    <div class="qw-calc__card" data-reveal="scale" style="--reveal-delay: 120ms">
      <div class="qw-calc__inputs">
        <label class="field">
          <span class="field__label">{{ s.label_visits }}</span>
          <input class="input" type="number" inputmode="numeric" min="0" step="1" id="qwCalcVisits" value="{{ s.default_visits }}">
        </label>

        <label class="field">
          <span class="field__label">{{ s.label_ticket }}</span>
          <input class="input" type="number" inputmode="numeric" min="0" step="1" id="qwCalcTicket" value="{{ s.default_ticket }}">
        </label>

        <label class="field">
          <span class="field__label">{{ s.label_rate }} <strong data-qw-calc-rate-out>{{ s.default_rate }}</strong>%</span>
          <input class="qw-calc__range" type="range" min="10" max="60" step="1" id="qwCalcRate" value="{{ s.default_rate }}">
        </label>
      </div>

      <div class="qw-calc__results">
        <div class="qw-calc__result">
          <span class="qw-calc__result-value" data-qw-calc-customers>0</span>
          <span class="qw-calc__result-label">{{ s.label_customers }}</span>
        </div>
        <div class="qw-calc__result qw-calc__result--accent">
          <span class="qw-calc__result-value" data-qw-calc-monthly>0 €</span>
          <span class="qw-calc__result-label">{{ s.label_monthly }}</span>
        </div>
        <div class="qw-calc__result">
          <span class="qw-calc__result-value" data-qw-calc-yearly>0 €</span>
          <span class="qw-calc__result-label">{{ s.label_yearly }}</span>
        </div>
      </div>

      <div class="qw-calc__cta">
        {%- if s.note != blank -%}
          <p class="qw-calc__note">{{ s.note }}</p>
        {%- endif -%}
        {%- if s.cta_label != blank -%}
          <a
            href="{% if s.starter_variant_id != blank %}/cart/{{ s.starter_variant_id }}:1{% else %}{{ s.cta_url | default: '#quiero-mi-web' }}{% endif %}"
            class="btn btn--primary btn--lg"
            data-qw-cta="click_calc"
            data-plan="starter"
            {%- if s.starter_variant_id != blank %}
              data-qw-buy="{{ s.starter_variant_id }}"
              data-qw-buy-dest="cart"
            {%- endif %}
          >
            {{ s.cta_label }}
            {% render 'icon', name: 'arrow-right', size: 16 %}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if s.disclaimer != blank -%}
      <p class="qw-calc__disclaimer">{{ s.disclaimer }}</p>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    function fmtEUR(n) {
      try {
        return new Intl.NumberFormat('es-ES', { maximumFractionDigits: 0 }).format(Math.round(n)) + ' €';
      } catch (e) {
        return Math.round(n) + ' €';
      }
    }
    function fmtNum(n) {
      try {
        return new Intl.NumberFormat('es-ES', { maximumFractionDigits: 0 }).format(Math.round(n));
      } catch (e) {
        return String(Math.round(n));
      }
    }

    function boot() {
      var root = document.querySelector('[data-qw-calc]');
      if (!root) return;

      var visits = root.querySelector('#qwCalcVisits');
      var ticket = root.querySelector('#qwCalcTicket');
      var rate = root.querySelector('#qwCalcRate');
      var rateOut = root.querySelector('[data-qw-calc-rate-out]');
      var custOut = root.querySelector('[data-qw-calc-customers]');
      var moOut = root.querySelector('[data-qw-calc-monthly]');
      var yrOut = root.querySelector('[data-qw-calc-yearly]');
      if (!visits || !ticket || !rate) return;

      function update() {
        var v = Math.max(0, parseFloat(visits.value) || 0);
        var t = Math.max(0, parseFloat(ticket.value) || 0);
        var r = Math.max(0, Math.min(100, parseFloat(rate.value) || 0));

        var lostCustomers = v * (r / 100);
        var lostMonthly = lostCustomers * t;
        var lostYearly = lostMonthly * 12;

        if (rateOut) rateOut.textContent = Math.round(r);
        if (custOut) custOut.textContent = fmtNum(lostCustomers);
        if (moOut) moOut.textContent = fmtEUR(lostMonthly);
        if (yrOut) yrOut.textContent = fmtEUR(lostYearly);
      }

      [visits, ticket, rate].forEach(function (el) {
        el.addEventListener('input', update);
      });
      update();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  })();
</script>

{% schema %}
{
  "name": "Webs · Calculadora",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Lo que te está costando no tener web" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Calcula cuántos clientes " },
    { "type": "text", "id": "heading_accent", "label": "Parte destacada", "default": "estás perdiendo ahora mismo." },
    { "type": "textarea", "id": "body", "label": "Subtítulo", "default": "Ajusta los números a tu negocio. Es una estimación, pero te da una idea real de lo que cuesta seguir esperando." },
    { "type": "header", "content": "Campos" },
    { "type": "text", "id": "label_visits", "label": "Etiqueta: búsquedas", "default": "Búsquedas al mes en tu zona" },
    { "type": "number", "id": "default_visits", "label": "Valor inicial: búsquedas", "default": 200 },
    { "type": "text", "id": "label_ticket", "label": "Etiqueta: ticket medio", "default": "¿Cuánto te paga un cliente de media? (€)" },
    { "type": "number", "id": "default_ticket", "label": "Valor inicial: ticket medio", "default": 40 },
    { "type": "text", "id": "label_rate", "label": "Etiqueta: % que se pierde", "default": "% que pierdes por no tener web:" },
    { "type": "number", "id": "default_rate", "label": "Valor inicial: % (10-60)", "default": 30 },
    { "type": "header", "content": "Resultados" },
    { "type": "text", "id": "label_customers", "label": "Etiqueta: clientes perdidos", "default": "Clientes perdidos al mes" },
    { "type": "text", "id": "label_monthly", "label": "Etiqueta: pérdida mensual", "default": "Ingresos perdidos al mes" },
    { "type": "text", "id": "label_yearly", "label": "Etiqueta: pérdida anual", "default": "Ingresos perdidos al año" },
    { "type": "header", "content": "Botón" },
    { "type": "textarea", "id": "note", "label": "Nota sobre el botón", "default": "Con una web desde 49 € puedes empezar a recuperarlos." },
    { "type": "text", "id": "cta_label", "label": "Texto del botón", "default": "Quiero mi web por 49 €" },
    { "type": "url", "id": "cta_url", "label": "Enlace del botón (alternativo)", "info": "Se usa sólo si el ID de variante de abajo está vacío." },
    { "type": "text", "id": "starter_variant_id", "label": "ID de variante del plan STARTER", "info": "Si lo rellenas, el botón añade esta variante al carrito y lleva al carrito (para poder ofrecer el mantenimiento antes de pagar)." },
    { "type": "header", "content": "Aviso" },
    { "type": "text", "id": "disclaimer", "label": "Texto pequeño bajo la calculadora", "default": "Estimación orientativa a partir de los datos que introduces. No sustituye un análisis real de tu negocio." }
  ],
  "presets": [
    {
      "name": "Webs · Calculadora"
    }
  ]
}
{% endschema %}
