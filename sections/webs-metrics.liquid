{{ 'qm-webs.css' | asset_url | stylesheet_tag }}
{{ 'qm-webs-extra.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<section class="section qw-metrics">
  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if s.eyebrow != blank -%}
        <p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>
      {%- endif -%}
      <h2 class="t-h2" data-reveal>{{ s.heading }}</h2>
      {%- if s.body != blank -%}
        <p class="t-lead" data-reveal style="--reveal-delay: 80ms">{{ s.body }}</p>
      {%- endif -%}
    </div>

    <div class="qw-metrics__grid" data-stagger="90">
      {%- for block in section.blocks -%}
        {%- liquid
          assign val = block.settings.value
          assign prefix = ''
          assign suffix = ''
          assign count_val = ''
          if val contains '%'
            assign count_val = val | remove: '%' | strip
            assign suffix = '%'
          elsif val contains 'días'
            assign count_val = val | remove: '<' | remove: 'días' | strip
            assign prefix = '<'
            assign suffix = ' días'
          elsif val contains 'h'
            assign count_val = val | remove: '<' | remove: 'h' | strip
            assign prefix = '<'
            assign suffix = 'h'
          elsif val contains '€'
            assign count_val = val | remove: '€' | strip
            assign suffix = '€'
          else
            assign count_val = val | strip
          endif
        -%}
        <div class="qw-metric card--glow" data-reveal {{ block.shopify_attributes }}>
          <span class="qw-metric__value">
            {%- if count_val != blank -%}
              {{ prefix }}<span data-count-to="{{ count_val }}">{{ count_val }}</span>{{ suffix }}
            {%- else -%}
              {{ val }}
            {%- endif -%}
          </span>
          <span class="qw-metric__label">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Webs · Métricas",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Nuestros compromisos" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "No prometemos humo. Esto es lo que te garantizamos." },
    { "type": "textarea", "id": "body", "label": "Subtítulo" }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Métrica",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "value", "label": "Número", "default": "100%" },
        { "type": "text", "id": "label", "label": "Descripción", "default": "Adaptada a móvil" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Webs · Métricas",
      "blocks": [
        { "type": "metric", "settings": { "value": "100%", "label": "Adaptada a móvil" } },
        { "type": "metric", "settings": { "value": "<7 días", "label": "Entrega media" } },
        { "type": "metric", "settings": { "value": "<24h", "label": "Tiempo de respuesta" } },
        { "type": "metric", "settings": { "value": "0€", "label": "Permanencia" } },
        { "type": "metric", "settings": { "value": "1", "label": "Ronda de cambios incluida" } }
      ]
    }
  ]
}
{% endschema %}
