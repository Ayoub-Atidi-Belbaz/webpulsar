{{ 'offer-popup.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<dialog
  class="offer-popup"
  data-offer-popup
  data-delay="{{ s.delay_seconds | default: 25 }}"
  data-frequency="{{ s.frequency | default: 'session' }}"
  data-scroll-trigger="{{ s.enable_scroll_trigger | default: true }}"
  data-exit-intent="{{ s.enable_exit_intent | default: true }}"
  aria-modal="true"
  aria-labelledby="offer-popup-title"
>
  <div class="offer-popup__overlay" data-offer-popup-dismiss aria-hidden="true"></div>
  <div class="offer-popup__panel">
    <button
      type="button"
      class="offer-popup__close"
      data-offer-popup-dismiss
      aria-label="{{ 'accessibility.close' | t | default: 'Cerrar ventana' }}"
    >
      {% render 'icon', name: 'close', size: 15 %}
    </button>

    {%- if s.badge != blank -%}
      <div class="offer-popup__badge-wrap">
        <span class="chip chip--violet offer-popup__badge">
          <span class="offer-popup__badge-dot" aria-hidden="true"></span>
          {{ s.badge }}
        </span>
      </div>
    {%- endif -%}

    <h2 id="offer-popup-title" class="offer-popup__title">{{ s.heading }}</h2>

    {%- if s.body != blank -%}
      <p class="offer-popup__body">{{ s.body }}</p>
    {%- endif -%}

    <div class="offer-popup__actions">
      <a
        href="{% if s.variant_id != blank %}/cart/{{ s.variant_id }}:1{% else %}{{ s.cta_url | default: '#planes' }}{% endif %}"
        class="btn btn--primary btn--lg btn--full"
        data-qw-cta="click_offer_popup"
        data-plan="starter"
        {%- if s.variant_id != blank %}
          data-qw-buy="{{ s.variant_id }}"
        {%- endif %}
      >
        {{ s.cta_label }}
      </a>
      <button type="button" class="btn btn--text offer-popup__skip" data-offer-popup-dismiss>
        {{ s.dismiss_label }}
      </button>
    </div>
  </div>
</dialog>

<script>
  (function () {
    function boot() {
      var popup = document.querySelector('[data-offer-popup]');
      if (!popup || popup.__offerPopupInit) return;
      popup.__offerPopupInit = true;

      var STORAGE_KEY = 'qwOfferPopupSeenAt';
      var frequency = popup.dataset.frequency || 'session';
      var delayMs = (parseFloat(popup.dataset.delay) || 25) * 1000;
      var enableScroll = popup.dataset.scrollTrigger !== 'false';
      var enableExit = popup.dataset.exitIntent !== 'false';

      var previouslyFocused = null;
      var isOpen = false;
      var timerId = null;

      function alreadyShown() {
        try {
          if (frequency === 'always') return false;
          if (frequency === 'session') return sessionStorage.getItem(STORAGE_KEY) === '1';
          var days = parseInt(frequency, 10) || 1;
          var seenAt = parseInt(localStorage.getItem(STORAGE_KEY) || '0', 10);
          return Date.now() - seenAt < days * 24 * 60 * 60 * 1000;
        } catch (e) {
          return false;
        }
      }

      function markShown() {
        try {
          sessionStorage.setItem(STORAGE_KEY, '1');
          if (frequency !== 'session' && frequency !== 'always') {
            localStorage.setItem(STORAGE_KEY, String(Date.now()));
          }
        } catch (e) {}
      }

      function isUserInteractingWithForm() {
        var active = document.activeElement;
        if (!active) return false;
        var tag = active.tagName.toLowerCase();
        return tag === 'input' || tag === 'textarea' || tag === 'select' || active.isContentEditable;
      }

      function open() {
        if (isOpen || alreadyShown() || isUserInteractingWithForm()) return;
        isOpen = true;
        markShown();
        cleanupListeners();

        previouslyFocused = document.activeElement;

        if (typeof popup.showModal === 'function') {
          try {
            popup.showModal();
          } catch (e) {
            popup.setAttribute('open', '');
          }
        } else {
          popup.setAttribute('open', '');
        }

        popup.classList.add('is-active');
        document.body.style.overflow = 'hidden';

        var firstBtn = popup.querySelector('.btn--primary, .offer-popup__close');
        if (firstBtn) firstBtn.focus();
      }

      function close() {
        if (!isOpen) return;
        isOpen = false;
        popup.classList.remove('is-active');
        document.body.style.overflow = '';

        if (typeof popup.close === 'function') {
          try { popup.close(); } catch (e) { popup.removeAttribute('open'); }
        } else {
          popup.removeAttribute('open');
        }

        if (previouslyFocused && previouslyFocused.focus) {
          previouslyFocused.focus();
        }
      }

      // Cerrar en clics a dismiss
      popup.querySelectorAll('[data-offer-popup-dismiss]').forEach(function (el) {
        el.addEventListener('click', close);
      });

      // Cerrar con Escape desde cualquier parte del documento
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && isOpen) {
          e.preventDefault();
          close();
        }
      });

      // Focus trap dentro del popup cuando está abierto
      popup.addEventListener('keydown', function (e) {
        if (e.key === 'Tab') {
          var focusables = Array.prototype.slice.call(
            popup.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])')
          ).filter(function (el) { return el.offsetParent !== null; });
          if (!focusables.length) return;
          var first = focusables[0];
          var last = focusables[focusables.length - 1];
          if (e.shiftKey) {
            if (document.activeElement === first) {
              e.preventDefault();
              last.focus();
            }
          } else {
            if (document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        }
      });

      // Disparador 1: Scroll >= 35% de la página o llegada a sección de planes
      function onScroll() {
        if (isOpen) return;
        var scrollPos = window.scrollY + window.innerHeight;
        var docHeight = document.documentElement.scrollHeight || document.body.scrollHeight;
        var planesEl = document.getElementById('planes');
        var passedPlanes = planesEl && (window.scrollY + window.innerHeight * 0.6 >= planesEl.offsetTop);
        if ((docHeight > 800 && scrollPos / docHeight >= 0.35) || passedPlanes) {
          open();
        }
      }

      // Disparador 2: Exit-intent en escritorio (ratón saliendo por la parte superior tras >= 6s)
      var pageStartTime = Date.now();
      function onMouseLeave(e) {
        if (isOpen) return;
        if (Date.now() - pageStartTime > 6000 && e.clientY <= 10) {
          open();
        }
      }

      function cleanupListeners() {
        if (timerId) clearTimeout(timerId);
        window.removeEventListener('scroll', onScroll);
        document.documentElement.removeEventListener('mouseleave', onMouseLeave);
        if (window.__lenisInstance && window.__lenisInstance.off) {
          window.__lenisInstance.off('scroll', onScroll);
        }
      }

      if (!alreadyShown()) {
        if (delayMs > 0) {
          timerId = setTimeout(open, delayMs);
        }
        if (enableScroll) {
          window.addEventListener('scroll', onScroll, { passive: true });
          if (window.__lenisInstance && window.__lenisInstance.on) {
            window.__lenisInstance.on('scroll', onScroll);
          }
        }
        if (enableExit && window.matchMedia('(pointer: fine)').matches) {
          document.documentElement.addEventListener('mouseleave', onMouseLeave);
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  })();
</script>

{% schema %}
{
  "name": "Popup de oferta",
  "tag": "div",
  "settings": [
    { "type": "number", "id": "delay_seconds", "label": "Segundos antes de mostrarse (tiempo prudente)", "default": 25 },
    { "type": "checkbox", "id": "enable_scroll_trigger", "label": "Mostrar al hacer 50% de scroll", "default": true },
    { "type": "checkbox", "id": "enable_exit_intent", "label": "Mostrar en intención de salida (PC)", "default": true },
    {
      "type": "select",
      "id": "frequency",
      "label": "Frecuencia",
      "options": [
        { "value": "always", "label": "Cada vez que entra" },
        { "value": "session", "label": "Una vez por visita" },
        { "value": "1", "label": "Una vez al día" },
        { "value": "7", "label": "Una vez a la semana" }
      ],
      "default": "session"
    },
    { "type": "header", "content": "Contenido" },
    { "type": "text", "id": "badge", "label": "Etiqueta", "default": "OFERTA DE LANZAMIENTO" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "¿Quieres esta oferta?" },
    { "type": "textarea", "id": "body", "label": "Texto", "default": "Consigue tu web profesional por 49 €. Sin cuotas ni permanencia." },
    { "type": "header", "content": "Botón" },
    { "type": "text", "id": "cta_label", "label": "Texto del botón", "default": "Quiero mi web por 49 €" },
    { "type": "url", "id": "cta_url", "label": "Enlace del botón (alternativo)", "info": "Se usa sólo si el ID de variante de abajo está vacío." },
    { "type": "text", "id": "variant_id", "label": "ID de variante del plan STARTER", "info": "Si lo rellenas, el botón añade esta variante al carrito.", "default": "64575079678321" },
    { "type": "text", "id": "dismiss_label", "label": "Botón de cerrar", "default": "No, gracias" }
  ],
  "presets": [{ "name": "Popup de oferta" }]
}
{% endschema %}

