{%- comment -%}
  Datos estructurados (JSON-LD) para SEO y motores de IA (Bloque G).
  Esquema oficial de WebPulsar: ProfessionalService, WebSite y Ofertas de planes web.
{%- endcomment -%}

{%- liquid
  assign currency = cart.currency.iso_code | default: shop.currency | default: 'EUR'
  assign contact_email = settings.contact_email | default: 'hello@quickmotionai.com'
  assign contact_wa = settings.contact_whatsapp | default: '34632358260'
  assign contact_loc = settings.contact_location | default: 'Murcia, España'
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "{{ shop.url }}/#organization",
      "name": {{ shop.name | default: 'WebPulsar' | json }},
      "url": "{{ shop.url }}",
      "description": "Diseño y desarrollo de páginas web profesionales para negocios locales y pymes desde 49 €. Sin permanencia, adaptadas a móvil y optimizadas para Google y WhatsApp.",
      "email": {{ contact_email | json }},
      "telephone": "+{{ contact_wa }}",
      "priceRange": "€€",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": {{ contact_loc | json }},
        "addressCountry": "ES"
      },
      "areaServed": {
        "@type": "Country",
        "name": "España"
      }
      {%- if settings.favicon != blank -%},
      "logo": "https:{{ settings.favicon | image_url: width: 512 }}"
      {%- endif -%}
    },
    {
      "@type": "WebSite",
      "@id": "{{ shop.url }}/#website",
      "url": "{{ shop.url }}",
      "name": {{ shop.name | default: 'WebPulsar' | json }},
      "publisher": { "@id": "{{ shop.url }}/#organization" },
      "inLanguage": "es"
    },
    {
      "@type": "Service",
      "@id": "{{ shop.url }}/#service",
      "name": "Desarrollo de páginas web para negocios locales",
      "serviceType": "Diseño y desarrollo web",
      "provider": { "@id": "{{ shop.url }}/#organization" },
      "areaServed": { "@type": "Country", "name": "España" },
      "audience": {
        "@type": "BusinessAudience",
        "name": "Negocios locales, pymes, clínicas, talleres, restaurantes y profesionales autónomos"
      },
      "description": "Servicio de diseño y creación de páginas web profesionales entregadas en menos de 7 días. Adaptación total a dispositivos móviles, integración con WhatsApp para reservas y consultas directas, optimización de velocidad y SEO local.",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "{{ currency }}",
        "lowPrice": "49.00",
        "highPrice": "799.00",
        "offerCount": 4,
        "offers": [
          {
            "@type": "Offer",
            "name": "Plan STARTER",
            "description": "Web profesional de una página adaptada a móvil con botón directo a WhatsApp. Entrega en menos de 7 días sin cuotas mensuales.",
            "price": "49.00",
            "priceCurrency": "{{ currency }}",
            "url": "{{ shop.url }}/#planes",
            "availability": "https://schema.org/InStock"
          },
          {
            "@type": "Offer",
            "name": "Plan PRO",
            "description": "Hasta 5 páginas profesionales, diseño personalizado, SEO básico, Google Maps y optimización móvil avanzada.",
            "price": "199.00",
            "priceCurrency": "{{ currency }}",
            "url": "{{ shop.url }}/#planes",
            "availability": "https://schema.org/InStock"
          },
          {
            "@type": "Offer",
            "name": "Plan BUSINESS",
            "description": "Web completa con sistema de reservas, citas, automatizaciones y analítica avanzada.",
            "price": "499.00",
            "priceCurrency": "{{ currency }}",
            "url": "{{ shop.url }}/#planes",
            "availability": "https://schema.org/InStock"
          },
          {
            "@type": "Offer",
            "name": "Plan A MEDIDA",
            "description": "Plataformas SaaS, ecommerce y aplicaciones web a medida con presupuesto cerrado antes de empezar.",
            "price": "799.00",
            "priceCurrency": "{{ currency }}",
            "url": "{{ shop.url }}/#planes",
            "availability": "https://schema.org/InStock"
          }
        ]
      }
    }
  ]
}
</script>
