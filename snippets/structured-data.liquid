{%- comment -%}
  Datos estructurados (JSON-LD) de WebPulsar.

  Los rastreadores (Google, y los de las plataformas de anuncios que revisan la
  landing) no ven las maquetas ni las animaciones: entienden el texto y este
  esquema. Tiene que describir lo que se vende de verdad.

  Los precios salen de los productos de Shopify, nunca escritos a mano, para
  que no puedan desincronizarse. Si un producto se borra o cambia de handle,
  su oferta simplemente deja de salir en vez de romper el JSON.
{%- endcomment -%}

{%- liquid
  assign starter = all_products['web-starter-pagina-profesional']
  assign pro = all_products['web-pro-presencia-online-completa']
  assign business = all_products['web-business-herramienta-de-ventas']
  assign currency = cart.currency.iso_code | default: shop.currency

  assign starter_desc = 'Una página profesional con diseño responsive, información del negocio, servicios, fotos, botón de WhatsApp, ubicación y formulario de contacto.'
  assign pro_desc = 'Hasta 5 páginas con diseño personalizado, SEO básico, formularios, Google Maps, redes sociales y galería profesional.'
  assign business_desc = 'Web completa con reservas y citas, automatizaciones, SEO avanzado, formularios avanzados, integraciones, Google Business y analítica.'
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ shop.url }}/#organization",
      "name": {{ shop.name | json }},
      "legalName": "Stilness LLC",
      "url": "{{ shop.url }}",
      "description": "Diseño de páginas web profesionales para negocios locales: peluquerías, estética, talleres, restaurantes, fisioterapia y más. Webs adaptadas a móvil, entrega media en menos de 7 días y sin permanencia.",
      "email": "hello@quickmotionai.com",
      "areaServed": { "@type": "Country", "name": "España" }
      {%- if settings.logo != blank -%},
      "logo": "https:{{ settings.logo | image_url: width: 512 }}"
      {%- endif -%}
    },
    {
      "@type": "WebSite",
      "@id": "{{ shop.url }}/#website",
      "url": "{{ shop.url }}",
      "name": {{ shop.name | json }},
      "publisher": { "@id": "{{ shop.url }}/#organization" },
      "inLanguage": "es"
    },
    {
      "@type": "Service",
      "@id": "{{ shop.url }}/#service",
      "name": "Diseño de páginas web para negocios locales",
      "serviceType": "Diseño web",
      "provider": { "@id": "{{ shop.url }}/#organization" },
      "areaServed": { "@type": "Country", "name": "España" },
      "audience": {
        "@type": "BusinessAudience",
        "name": "Negocios locales que quieren presencia online: peluquerías, centros de estética, talleres, restaurantes, fisioterapia, clínicas e inmobiliarias"
      },
      "description": "Creamos la web de tu negocio en pago único y sin permanencia, desde 49 €. Nos cuentas cómo es tu negocio, diseñamos y montamos la página, y te la entregamos lista para que tus clientes te encuentren y te escriban. Mantenimiento mensual opcional. Dominio y hosting no incluidos.",
      "termsOfService": "{{ shop.url }}/pages/terminos",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "{{ currency }}",
        {%- if starter != blank %}"lowPrice": "{{ starter.price | divided_by: 100.0 }}",{% endif %}
        {%- if business != blank %}"highPrice": "{{ business.price | divided_by: 100.0 }}",{% endif %}
        "offers": [
          {%- if starter != blank -%}
          {
            "@type": "Offer",
            "name": {{ starter.title | json }},
            "description": {{ starter_desc | json }},
            "price": "{{ starter.price | divided_by: 100.0 }}",
            "priceCurrency": "{{ currency }}",
            "url": "{{ shop.url }}{{ starter.url }}",
            "availability": "https://schema.org/InStock"
          }{%- if pro != blank or business != blank -%},{%- endif -%}
          {%- endif -%}
          {%- if pro != blank -%}
          {
            "@type": "Offer",
            "name": {{ pro.title | json }},
            "description": {{ pro_desc | json }},
            "price": "{{ pro.price | divided_by: 100.0 }}",
            "priceCurrency": "{{ currency }}",
            "url": "{{ shop.url }}{{ pro.url }}",
            "availability": "https://schema.org/InStock"
          }{%- if business != blank -%},{%- endif -%}
          {%- endif -%}
          {%- if business != blank -%}
          {
            "@type": "Offer",
            "name": {{ business.title | json }},
            "description": {{ business_desc | json }},
            "price": "{{ business.price | divided_by: 100.0 }}",
            "priceCurrency": "{{ currency }}",
            "url": "{{ shop.url }}{{ business.url }}",
            "availability": "https://schema.org/InStock"
          }
          {%- endif -%}
        ]
      }
    }
  ]
}
</script>
