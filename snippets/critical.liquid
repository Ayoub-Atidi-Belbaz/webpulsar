<style id="critical-css">
  :root {
    --c-void: #0B0B12;
    --c-bg: #0B0B12;
    --c-elev-1: #11111B;
    --c-elev-2: #17172a;
    --c-text: #F5F5FF;
    --c-text-soft: #A1A1B3;
    --c-text-dim: #7d7d92;
    --c-violet: #6C3BFF;
    --c-cyan: #A855F7;
    --c-green: #00ff94;
    --c-line: rgba(255, 255, 255, 0.07);
    --c-line-strong: rgba(255, 255, 255, 0.14);
    --c-line-accent: rgba(108, 59, 255, 0.35);
    --g-accent: linear-gradient(135deg, var(--c-violet) 0%, var(--c-cyan) 100%);
    --f-display: 'Clash Display', 'Clash Fallback', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --f-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --f-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    --t-mega: clamp(3.25rem, 1.6rem + 7.3vw, 7.5rem);
    --t-h1: clamp(2.5rem, 1.45rem + 4.7vw, 5.25rem);
    --t-h2: clamp(2rem, 1.35rem + 2.9vw, 3.5rem);
    --t-lead: clamp(1.0625rem, 0.99rem + 0.33vw, 1.3125rem);
    --t-body: clamp(0.9375rem, 0.91rem + 0.13vw, 1.0625rem);
    --header-h: 68px;
    --dur-fast: 150ms;
    --dur-base: 300ms;
    --dur-slow: 600ms;
    --dur-hero: 900ms;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @media screen and (min-width: 990px) {
    :root { --header-h: 80px; }
  }

  *, *::before, *::after {
    box-sizing: border-box;
  }

  html {
    background-color: var(--c-void);
    color: var(--c-text);
    font-family: var(--f-body);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }

  body {
    margin: 0;
    padding: 0;
    background-color: var(--c-void);
    color: var(--c-text);
    min-height: 100vh;
    overflow-x: hidden;
  }

  .grain {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.03;
    background-image: url('{{ 'grain.svg' | asset_url }}');
    background-size: 160px 160px;
  }

  .wrap {
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 0.7rem + 2.4vw, 3.5rem);
  }

  /* Progressive Enhancement: Contenido visible si JS tarda o no ejecuta */
  [data-reveal] {
    opacity: 1;
  }
  html.js [data-reveal]:not(.is-in) {
    opacity: 0;
    transform: translateY(16px);
  }
  /* Hero and header elements above-the-fold MUST NEVER be hidden to ensure instant LCP */
  html.js .qw-hero [data-reveal],
  html.js .site-header [data-reveal] {
    opacity: 1 !important;
    transform: none !important;
  }
  html.js [data-reveal].is-in {
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--dur-slow) var(--ease-out), transform var(--dur-slow) var(--ease-out);
    transition-delay: var(--reveal-delay, 0ms);
  }
  @media (prefers-reduced-motion: reduce) {
    html.js [data-reveal]:not(.is-in),
    html.js [data-reveal].is-in {
      opacity: 1 !important;
      transform: none !important;
      transition: opacity 150ms ease !important;
    }
  }

  /* Cabecera Above-the-fold */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    height: var(--header-h);
    background: rgba(11, 11, 18, 0.88);
    border-bottom: 1px solid var(--c-line);
    transition: transform var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);
  }

  /* Hero Above-the-fold */
  .qw-hero {
    position: relative;
    padding-top: clamp(2rem, 1rem + 3vw, 4rem);
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
    overflow: hidden;
  }

  .qw-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .qw-hero__poster-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.38;
    filter: saturate(1.15) contrast(1.05);
    pointer-events: none;
  }
  .qw-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.38;
    filter: saturate(1.15) contrast(1.05);
  }
  .qw-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% 35%, rgba(108, 59, 255, 0.14) 0%, transparent 65%),
      linear-gradient(to top, var(--c-void) 0%, rgba(5, 5, 8, 0.45) 45%, rgba(5, 5, 8, 0.25) 70%, rgba(5, 5, 8, 0.65) 100%),
      linear-gradient(to bottom, var(--c-void) 0%, transparent 18%);
  }

  .qw-hero__center {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .qw-hero__title-c {
    font-family: var(--f-display);
    font-size: var(--t-h1);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin-top: 1rem;
    margin-bottom: 1rem;
    max-width: 900px;
  }

  .t-grad {
    background: var(--g-accent);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--f-body);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 999px;
    padding: 0.75rem 1.5rem;
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
  }

  .btn--primary {
    background: var(--c-violet);
    color: #ffffff;
    box-shadow: 0 0 0 1px var(--c-line-accent), 0 8px 32px -8px rgba(108, 59, 255, 0.45);
  }
</style>
