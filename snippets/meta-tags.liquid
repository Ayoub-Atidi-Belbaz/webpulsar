{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: 'Webs profesionales para negocios locales desde 49 €. Sin permanencia.'

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign og_image_obj = page_image | default: settings.share_image
-%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if og_image_obj != blank -%}
  <meta property="og:image" content="http:{{ og_image_obj | image_url: width: 1200, height: 630 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image_obj | image_url: width: 1200, height: 630 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:image" content="https:{{ og_image_obj | image_url: width: 1200, height: 630 }}">
{%- else -%}
  <meta property="og:image" content="{{ request.origin }}/assets/hero-web-dev.jpg">
  <meta property="og:image:secure_url" content="{{ request.origin }}/assets/hero-web-dev.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:image" content="{{ request.origin }}/assets/hero-web-dev.jpg">
{%- endif -%}

<meta name="twitter:image:alt" content="{{ og_title | escape }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
